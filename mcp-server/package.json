{
  "name": "share-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server for the Share expense tracker backend",
  "main": "dist/mcp-server/src/index.js",
  "bin": {
    "share-mcp-server": "dist/mcp-server/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts http",
    "start": "node dist/mcp-server/src/index.js",
    "start:stdio": "node dist/mcp-server/src/index.js stdio",
    "start:http": "node dist/mcp-server/src/index.js http",
    "start:sse": "node dist/mcp-server/src/index.js sse",
    "test": "tsx --test src/**/*.test.ts",
    "smoke": "node scripts/smoke-stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sql.js": "^1.14.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
